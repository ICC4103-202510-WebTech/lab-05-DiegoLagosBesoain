<h1>List of USers</h1>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>first_name</th>
      <th>last_name</th>
      <th>email</th>
      <th>created_at</th>
      <th>updated_at</th>
      <th>Link</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.first_name %></td>
        <td><%= user.last_name %></td>
        <td><%= user.email %></td>
        <td><%= user.created_at %></td>
        <td><%= user.updated_at %></td>
        <td><%= link_to "see user", user_path(user)%></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to "Crear nuevo usuario", new_user_path, class: "btn btn-primary" %>