<h1>List of Users</h1>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>First Name</th>
      <th>Last Name</th>
      <th>Email</th>
      <th>Created At</th>
      <th>Updated At</th>
      <th>Messages Sent</th> 
      <th>Link</th>
      <th>Edit</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.first_name %></td>
        <td><%= user.last_name %></td>
        <td><%= user.email %></td>
        <td><%= user.created_at %></td>
        <td><%= user.updated_at %></td>
        <td><%= Message.where(user_id: user.id).count %></td>
        <td><%= link_to "See user", user_path(user) %></td>
        <% if can? :edit, user %>
          <td><%= link_to "edit user", edit_user_path(user)%></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>



