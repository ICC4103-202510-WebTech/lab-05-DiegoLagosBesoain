<div class="container mt-5">
  <div class="card">
    <div class="card-header bg-primary text-white">
      <h3>User ID: <%= @user.id %></h3>
    </div>
    <div class="card-body">
      <p><strong>First Name:</strong> <%= @user.first_name %></p>
      <p><strong>Last Name:</strong> <%= @user.last_name %></p>
      <p><strong>Email:</strong> <%= @user.email %></p>
      <p><strong>Created At:</strong> <%= @user.created_at %></p>
      <p><strong>Updated At:</strong> <%= @user.updated_at %></p>
    </div>
    <div class="card-footer">
      <%= link_to "Back to Users", users_path, class: "btn btn-secondary" %>
      <%= link_to "Edit User", edit_user_path(@user), class: "btn btn-dark" %>
    </div>
  </div>

  <div class="mt-5">
    <h4>All Chats</h4>
    <ul class="list-group">
      <% @chats.each do |chat| %>
        <li class="list-group-item">
          <p><strong>Chat ID:</strong> <%= chat.id %></p>
          <p><strong>Sender ID:</strong> <%= chat.sender_id %></p>
          <p><strong>Receiver ID:</strong> <%= chat.receiver_id %></p>
          <p><strong>Created At:</strong> <%= chat.created_at.strftime("%d %b %Y, %H:%M") %></p>
          <div class="d-flex gap-2 mt-2">
            <%= link_to "View", chat_path(chat), class: "btn btn-sm btn-primary" %>
            <%= link_to "Edit", edit_chat_path(chat), class: "btn btn-sm btn-warning" %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="mt-5">
    <h4>Messages Sent by <%= @user.first_name %></h4>
    <ul class="list-group">
      <% @messages.each do |message| %>
        <li class="list-group-item">
          <p><%= message.body %></p>
          <small class="text-muted">Sent At: <%= message.created_at.strftime("%d %b %Y, %H:%M") %></small><br>
          <small class="text-muted">Chat ID: <%= message.chat_id %></small>
        </li>
      <% end %>
    </ul>
  </div>
</div>
