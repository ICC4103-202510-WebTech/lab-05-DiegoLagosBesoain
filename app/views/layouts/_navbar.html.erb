<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <%= link_to 'Home', root_path, class: 'navbar-brand' %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      <div class="navbar-nav">
        <% if current_user.admin? %>
        <%= link_to 'Users', users_path, class: 'nav-link' %>
        <% end %>
        <%= link_to 'Messages', messages_path, class: 'nav-link' %>
        <% if user_signed_in? %>
        <%= link_to 'My Inbox', chats_path, class: 'nav-link' %>
        <% end %>
      </div>

      
      <% if user_signed_in? %>
        <div class="ms-auto d-flex align-items-center gap-3">
          <span class="navbar-text">
            Logged in as <strong><%= current_user.first_name + " " + current_user.last_name %></strong>
          </span>
          <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "btn btn-outline-danger", form: { class: "d-inline" } %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
