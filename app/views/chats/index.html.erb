<h1>List of Chats</h1>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>sender_id</th>
      <th>receiver_id</th>
      
      <th>created_at</th>
      <th>updated_at</th>
      <th>Link</th>
      <th>Edit</th>
    </tr>
  </thead>
  <tbody>
    <% @chats.each do |chat| %>
      <% if can? :edit, chat %>
      <tr>
        <td><%= chat.id %></td>
        <td><%= chat.sender_id %></td>
        <td><%= chat.receiver_id %></td>
        
        <td><%= chat.created_at %></td>
        <td><%= chat.updated_at %></td>
        <td><%= link_to "see chat", chat_path(chat)%></td>
        
        <td><%= link_to "edit chat", edit_chat_path(chat)%></td>
        
        
      </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
<%= link_to "Create new chat", new_chat_path, class: "btn btn-primary" %>