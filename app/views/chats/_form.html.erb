<%= form_with model: @chat, local: true do |form| %>
    
  
    <div>
      <%= form.label :sender_id, "sender_id" %>
      <%= form.collection_select :sender_id, User.all, :id, :id, prompt: "Select User" %>
  
    </div>
  
    <div>
      <%= form.label :receiver_id, "receiver_id" %>
      <%= form.collection_select :receiver_id, User.all, :id, :id, prompt: "Select User" %>
  
    </div>
  
    <div>
      <%= form.submit "CREATE" %>
    </div>
<% end %>
  