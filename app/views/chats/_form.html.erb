<%= form_with model: @chat, local: true do |form| %>

  <p>Estás creando un chat como: <strong><%= current_user.email %></strong></p>
  <%= form.hidden_field :sender_id, value: current_user.id %>

  <div>
    <%= form.label :receiver_id, "Selecciona al receptor" %>
    <%= form.collection_select :receiver_id, 
        User.where.not(id: current_user.id), 
        :id, :email, prompt: "Selecciona un usuario" %>
  </div>

  <div>
    <%= form.submit "Crear Chat" %>
  </div>

<% end %>