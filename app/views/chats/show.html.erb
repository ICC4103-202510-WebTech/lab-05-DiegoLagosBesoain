<div class="container mt-5">
  <div class="card">
    <div class="card-header bg-info text-white">
      <h4>Chat ID: <%= @chat.id %></h4>
    </div>
    <div class="card-body">
      <p><strong>Sender:</strong> <%= @chat.sender.first_name %> <%= @chat.sender.last_name %></p>
      <p><strong>Receiver:</strong> <%= @chat.receiver.first_name %> <%= @chat.receiver.last_name %></p>
      <hr>
      <h5>Messages</h5>
      <ul class="list-group">
        <% @messages.each do |message| %>
          <li class="list-group-item">
            <p><strong><%= message.user.first_name %>:</strong> <%= message.body %></p>
            <small class="text-muted"><%= message.created_at.strftime("%d %b %Y, %H:%M") %></small>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="card-footer">
      <%= link_to "Back to Chats", chats_path, class: "btn btn-secondary" %>
      <%= link_to "Edit chat", edit_chat_path, class: "btn btn-dark" %>    
    </div>
    
      
    
  </div>
</div>