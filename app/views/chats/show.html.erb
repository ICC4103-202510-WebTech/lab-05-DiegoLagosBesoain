<div class="container mt-5">
  <div class="card">
    <div class="card-header bg-info text-white">
      <h4>Chat ID: <%= @chat.id %></h4>
    </div>
    <div class="card-body">
      <p><strong>Sender:</strong> <%= @chat.sender.first_name %> <%= @chat.sender.last_name %> (ID: <%= @chat.sender_id %>)</p>
      <p><strong>Receiver:</strong> <%= @chat.receiver.first_name %> <%= @chat.receiver.last_name %> (ID: <%= @chat.receiver_id %>)</p>
      <hr>
      <h5>Messages</h5>
      <ul class="list-group">
        <% @messages.each do |message| %>
          <li class="list-group-item">
            <p><strong><%= message.user.first_name %> <%= message.user.last_name %>:</strong> <%= message.body %></p>
            <small class="text-muted">Sent At: <%= message.created_at.strftime("%d %b %Y, %H:%M") %></small>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="card-footer">
      <%= link_to "Back to Chats", chats_path, class: "btn btn-secondary" %>
      <% if can? :edit, @chat %>
            <%= link_to "Edit", edit_chat_path(@chat), class: "btn btn-dark" %>
      <% end%>    
    </div>
  </div>
</div>
