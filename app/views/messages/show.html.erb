<div class="container mt-5">
  <div class="card shadow">
    <div class="card-header bg-success text-white">
      <h4>Message ID: <%= @message.id %></h4>
    </div>
    <div class="card-body">
      <p><strong>Author:</strong> <%= @user.first_name %> <%= @user.last_name %> (User ID: <%= @user.id %>)</p>
      <hr>
      <p><strong>Chat ID:</strong> <%= @chat.id %></p>
      
      <p><strong>Sender:</strong> 
        <%= @chat.sender.first_name %> <%= @chat.sender.last_name %> (Sender ID: <%= @chat.sender_id %>)
      </p>
      
      <p><strong>Receiver:</strong> 
        <%= @chat.receiver.first_name %> <%= @chat.receiver.last_name %> (Receiver ID: <%= @chat.receiver_id %>)
      </p>

      <hr>
      
      <p><strong>Message Body:</strong></p>
      <p><%= @message.body %></p>
      
      <small class="text-muted">Created at: <%= @message.created_at.strftime("%d %b %Y, %H:%M") %></small>
    </div>
    
    <div class="card-footer">
      <%= link_to "Back to Messages", messages_path, class: "btn btn-secondary" %>
      <%= link_to "Edit Message", edit_message_path(@message), class: "btn btn-dark" %>
    </div>
  </div>
</div>
