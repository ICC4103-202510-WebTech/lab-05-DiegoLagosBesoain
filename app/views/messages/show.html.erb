<div class="container mt-5">
  <div class="card shadow">
    <div class="card-header bg-success text-white">
      <h4>Message ID: <%= @message.id %></h4>
    </div>
    <div class="card-body">
      <p><strong>User:</strong> <%= @user.first_name %> <%= @user.last_name %></p>
      <p><strong>Chat ID:</strong> <%= @chat.id %></p>
      <p><strong>Chat Between:</strong> 
        <%= @chat.sender.first_name %> <%= @chat.sender.last_name %> 
        and 
        <%= @chat.receiver.first_name %> <%= @chat.receiver.last_name %>
      </p>
      <hr>
      <p><strong>Message Body:</strong></p>
      <p><%= @message.body %></p>
      <small class="text-muted">Created at: <%= @message.created_at.strftime("%d %b %Y, %H:%M") %></small>
    </div>
    <div class="card-footer">
      <%= link_to "Back to Messages", messages_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>