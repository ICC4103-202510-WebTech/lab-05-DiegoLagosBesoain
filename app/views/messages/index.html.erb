<h1>List of Messages</h1>

<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>chat_id</th>
      <th>user_id</th>
      <th>body</th>
      <th>created_at</th>
      <th>updated_at</th>
      <th>Link</th>
      <th>Edit</th>
    </tr>
  </thead>
  <tbody>
    <% @messages.each do |message| %>
      <tr>
        <td><%= message.id %></td>
        <td><%= message.chat_id %></td>
        <td><%= message.user_id %></td>
        <td><%= message.body %></td>
        <td><%= message.created_at %></td>
        <td><%= message.updated_at %></td>
        <td><%= link_to "see message", message_path(message)%></td>
        <td><%= link_to "edit message", edit_message_path(message)%></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to "CREATE", new_message_path, class: "btn btn-primary" %>