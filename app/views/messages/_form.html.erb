<%= form_with model: @message, local: true do |f| %>
    <% if @message.errors.any? %>
      <div class="error-messages">
        <h2><%= pluralize(@message.errors.count, "error") %> do not let create the message</h2>
        <ul>
          <% @message.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  
    <div>
      <%= f.label :chat_id, "Chat" %>
      <%= f.select :chat_id, Chat.all.map { |chat| [chat.id, chat.id] }, prompt: "Selecciona un chat" %>
    </div>
  
    <div>
      <%= f.label :user_id, "User (author)" %>
      <%= f.select :user_id, User.all.map { |user| [user.id, user.id] }, prompt: "Selecciona un usuario" %>
    </div>
  
    <div>
      <%= f.label :body, "body" %><br>
      <%= f.text_area :body %>
    </div>
  
    <div>
      <%= f.submit "Enviar Mensaje" %>
    </div>
  <% end %>